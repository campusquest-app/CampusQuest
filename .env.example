NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Production: https://yggfswrzhkbhamrkjuse.supabase.co (anon + service role keys must match this project)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required for URInvolved daily sync (Vercel Cron + POST /api/sync/urinvolved)
CRON_SECRET=set-a-long-random-cron-secret

# Optional URI Athletics schedule feed from the official GoRhody / Sidearm calendar.
# When unset, Athletics sync is skipped (no fake games are created).
# One composite calendar is preferred. Extra official ICS/JSON URLs can be listed
# in URI_ATHLETICS_FEED_URLS (comma or newline separated) without replacing the primary.
URI_ATHLETICS_FEED_URL=https://example.com/feed
# URI_ATHLETICS_FEED_URLS=https://example.com/feed-extra.ics
# URI_ATHLETICS_FEED_FORMAT=ics

# Optional: Postgres URL for `npm run db:apply-qr`, `npm run db:apply-dm`, and similar scripts.
# Legacy / alternate names also accepted by some scripts (same fake URL shape):
#   DATABASE_URL  — older Supabase/script alias
#   POSTGRES_URL  — alternate pooler URL alias (e.g. torch-bearer maintenance scripts)
# Prefer SUPABASE_DB_URL for new setup. Do not put real credentials in this file.
# SUPABASE_DB_URL=postgresql://user:password@host:5432/database
# DATABASE_URL=postgresql://user:password@host:5432/database
# POSTGRES_URL=postgresql://user:password@host:5432/database

SUPABASE_PROOF_BUCKET=proof-images
# Optional Quad video upload size cap in bytes (default 80MB). Client mirror:
# NEXT_PUBLIC_QUAD_VIDEO_MAX_BYTES=83886080
# QUAD_VIDEO_MAX_BYTES=83886080
# Optional total media size per Quad post (default 500MB):
# NEXT_PUBLIC_QUAD_POST_TOTAL_UPLOAD_BYTES=524288000
# QUAD_POST_TOTAL_UPLOAD_BYTES=524288000
PROOF_REVIEW_API_KEY=set-a-long-random-review-key
LEGAL_POLICY_ADMIN_KEY=set-a-long-random-legal-policy-admin-key
MESSAGE_MODERATION_API_KEY=set-a-long-random-message-moderation-key
# Comma-separated platform admin emails for /api/moderation/* (server-only).
MODERATION_ADMIN_EMAILS=admin@example.com,moderator@example.com
PILOT_SCHOOL_NAME=University of Rhode Island
PILOT_SCHOOL_DOMAIN=uri.edu
# Client-readable pilot domain (falls back to PILOT_SCHOOL_DOMAIN when unset).
# NEXT_PUBLIC_PILOT_SCHOOL_DOMAIN=uri.edu

# Server-side Geocoding API (URInvolved building resolution).
# Resolution order: GOOGLE_MAPS_GEOCODING_API_KEY → GOOGLE_MAPS_SERVER_API_KEY → NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_GEOCODING_API_KEY=your-api-key
# Legacy / alternate server Maps key name (same purpose as GEOCODING key when set):
# GOOGLE_MAPS_SERVER_API_KEY=your-api-key

# Google Maps (The Realm map layer). Without a key the classic illustrated map is shown.
# Enable Maps JavaScript API + Directions API on the same key for walking routes.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-api-key

# Required for The Realm tilt / rotation / 3D buildings (vector renderer).
# Without this, Google Maps loads as raster and camera tilt/heading stay flat.
# Create in Google Cloud Console → Map Management (vector roadmap).
# Style the Map ID in Cloud Console — inline JS styles are ignored when mapId is set.
# Also set this on Vercel (Production + Preview) and redeploy — NEXT_PUBLIC_ vars
# are inlined at build time.
# Never commit real Map IDs with secrets; the ID itself is public (NEXT_PUBLIC_) but
# still keep API key restrictions tight.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_vector_map_id_here
# Legacy alias (still read if MAPS_MAP_ID is unset):
# NEXT_PUBLIC_GOOGLE_MAP_ID=your_vector_map_id_here

# Required for 6-digit URI email verification. Server-only — never NEXT_PUBLIC_.
# Generate a long random value (e.g. `openssl rand -hex 32`). Missing this fails send/verify.
# EMAIL_VERIFICATION_SECRET=generate-a-long-random-secret
# Direct Resend API for campus verification codes (not the Supabase SMTP path).
# Required to actually deliver codes. Auth confirmation/password-reset still use Supabase SMTP.
# RESEND_API_KEY=re_xxxxxxxx
# Optional From header (must be a verified Resend domain / sender).
# Production Resend currently verifies auth.campusquestapp.com — not the apex domain.
# RESEND_FROM_EMAIL=CampusQuest <noreply@auth.campusquestapp.com>
# Legacy / alternate From env name (same purpose as RESEND_FROM_EMAIL):
# EMAIL_VERIFICATION_FROM=CampusQuest <noreply@auth.campusquestapp.com>

# Required in production for auth email redirects (confirmation + password reset).
# Must be the public HTTPS origin — never localhost. Example:
# NEXT_PUBLIC_SITE_URL=https://campusquestapp.com
# Set this on Vercel → Production (and Preview if you test auth emails there), then redeploy.
# NEXT_PUBLIC_SITE_URL=https://example.com
# Legacy / alternate public origin names also checked by auth redirect helpers:
# SITE_URL=https://example.com
# NEXT_PUBLIC_APP_URL=https://example.com

# Optional extra exact emails allowed to sign up outside @uri.edu (comma-separated).
# Does not open arbitrary domains. Production students still need @uri.edu.
# APPROVED_QA_SIGNUP_EMAILS=qa@example.com
# Legacy single-email alias (still read; prefer APPROVED_QA_SIGNUP_EMAILS):
# QA_SIGNUP_EMAIL=qa@example.com
# Store-reviewer / QA test account (see lib/server/qaTestAccount.ts,
# and docs/store-reviewer-account.md).
# Exact email only — random @campusquestapp.com addresses do NOT bypass campus gates.
# Password is only needed the first time the account is created via Admin
# "Reset QA Onboarding" or scripts/ensure-qa-account.mjs.
# QA_TEST_ACCOUNT_EMAIL=test@example.com
# QA_TEST_ACCOUNT_PASSWORD=replace-with-test-password

# Dev/ops auth logging (server-only). Set to 1 to enable verbose auth diagnostics.
# AUTH_DEBUG=1
# AUTH_QA_LOG=1

# Apple Push Notification service (server-only — never NEXT_PUBLIC_).
# Create an Apple Push Notifications key (.p8) in the Apple Developer portal.
# APNS_KEY_ID=your-key-id
# APNS_TEAM_ID=your-apple-team-id
# APNS_BUNDLE_ID=com.example.campusquest
# APNS_P8_KEY=your-apns-p8-key-content
# APNS_PRODUCTION=true

# Server-only admin recipients for business/organization verification applications.
# Comma-separated. Never expose this to the client (do not use NEXT_PUBLIC_).
# ADMIN_VERIFICATION_EMAILS=admin1@example.com,admin2@example.com

# Dev-only: inject a fake URInvolved event at Weldin Hall starting in 8 minutes.
NEXT_PUBLIC_DEBUG_EVENT_PINS=false

# Dev-only: force "hurry" magic visuals (rings/sparks/badge) on all event markers.
NEXT_PUBLIC_DEBUG_MAP_MAGIC=false
