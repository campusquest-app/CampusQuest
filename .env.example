NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Production: https://yggfswrzhkbhamrkjuse.supabase.co (anon + service role keys must match this project)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required for URInvolved daily sync (Vercel Cron + POST /api/sync/urinvolved)
CRON_SECRET=set-a-long-random-cron-secret
# Optional: Postgres URL for `npm run db:apply-qr` and `npm run db:apply-dm`
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_PROOF_BUCKET=proof-images
PROOF_REVIEW_API_KEY=set-a-long-random-review-key
LEGAL_POLICY_ADMIN_KEY=set-a-long-random-legal-policy-admin-key
MESSAGE_MODERATION_API_KEY=set-a-long-random-message-moderation-key
MODERATION_ADMIN_EMAILS=nicholaslockhart22@gmail.com,campusquest@campusquestapp.com
PILOT_SCHOOL_NAME=University of Rhode Island
PILOT_SCHOOL_DOMAIN=uri.edu

# Server-side Geocoding API (URInvolved building resolution). Falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_GEOCODING_API_KEY=your_google_maps_api_key_here

# Google Maps (The Realm map layer). Without a key the classic illustrated map is shown.
# Enable Maps JavaScript API + Directions API on the same key for walking routes.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Vector Map ID for raised 3D buildings + tilt on The Realm.
# Create in Google Cloud Console → Map Management (vector roadmap).
# Style the Map ID in Cloud Console — inline JS styles are ignored when mapId is set.
NEXT_PUBLIC_GOOGLE_MAP_ID=your_vector_map_id_here

# Dev-only: inject a fake URInvolved event at Weldin Hall starting in 8 minutes.
NEXT_PUBLIC_DEBUG_EVENT_PINS=false

# Dev-only: force "hurry" magic visuals (rings/sparks/badge) on all event markers.
NEXT_PUBLIC_DEBUG_MAP_MAGIC=false
